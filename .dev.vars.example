# ===========================================
# Cloudflare Workers 环境变量配置示例
# ===========================================
# 复制此文件为 .dev.vars 并填入你的实际值
# cp .dev.vars.example .dev.vars
#
# 注意: .dev.vars 文件仅用于本地开发
# 生产环境请使用: npx wrangler secret put <变量名>
# ===========================================

# NextAuth 配置
AUTH_SECRET=your_auth_secret_here_generate_with_openssl_rand_base64_32

# OpenAI API
OPENAI_API_KEY="xxx"
OPENAI_API_BASE="https://xxx/v1"

# Douyin API
TIKHUB_BASE_URL="https://api.tikhub.io/api/v1"
TIKHUB_TOKEN="xxx"

# GitHub OAuth
GITHUB_ID="xxx"
GITHUB_SECRET="xxx"

# Google OAuth
GOOGLE_ID="xxx"
GOOGLE_SECRET="xxx"

# Agent
AGENT_MAX_ITERATIONS=12
